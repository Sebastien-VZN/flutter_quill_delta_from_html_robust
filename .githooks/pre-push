#!/usr/bin/env bash
# Pre-push guard — runs the same checks as CI (analyze, test, format) before
# a push reaches GitHub. Enable once after cloning with:
#   git config core.hooksPath .githooks

set -e

echo "[pre-push] Running analyze, tests and format check..."
echo "[pre-push] (this mirrors .github/workflows/build_check.yml)"

dart ./scripts/before_push.dart
status=$?

if [ $status -ne 0 ]; then
  echo "[pre-push] Checks failed. Push aborted."
  exit $status
fi

echo "[pre-push] All checks passed. Pushing."
exit 0