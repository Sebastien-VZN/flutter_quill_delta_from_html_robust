# Normalize line endings across platforms (LF in repo, native on checkout)
* text=auto eol=lf

# Dart / config / docs — always LF
*.dart   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.md     text eol=lf
*.sh     text eol=lf
*.json   text eol=lf
*.txt    text eol=lf
*.lock   text eol=lf
*.gitattributes text eol=lf
*.gitignore     text eol=lf
*.editorconfig  text eol=lf

# Windows-only scripts — keep CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binaries
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.tar.gz binary
*.tgz    binary
*.gz     binary
*.aab    binary
*.apk    binary
*.ipa    binary
*.dll    binary
*.so     binary
*.dylib  binary
*.exe    binary

# Generated / build artifacts (export-ignore keeps archives clean)
build/        export-ignore
.dart_tool/   export-ignore